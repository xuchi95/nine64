# Nine64 — environment variable reference.
# Names and placeholders only. Never commit real values to this file.
# Server secrets are stored in project secrets, not in a committed .env.

# ---------------------------------------------------------------------------
# PUBLIC (injected into the browser bundle — publishable values only)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ---------------------------------------------------------------------------
# SERVER-ONLY (never prefixed with VITE_, never sent to the browser)
# ---------------------------------------------------------------------------
# Backend connection used by server functions / routes
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
SUPABASE_PROJECT_ID=<project-ref>
# Bypasses RLS — privileged server work only
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# AI gateway credential for the AI Coach
LOVABLE_API_KEY=<managed-by-platform>
# Optional model override for the AI Coach
COACH_MODEL=<model-id>

# HMAC salt for rate-limit subject hashing (raw IPs are never stored)
RATE_LIMIT_SALT=<random-64-char-string>

# Cloudflare Turnstile server secret (contact form, sign-up)
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# Fair Play worker (private Cloud Run, OIDC)
FAIRPLAY_WORKER_AUDIENCE=<oidc-audience>
FAIRPLAY_WORKER_SERVICE_ACCOUNTS=<service-account-emails-comma-separated>
